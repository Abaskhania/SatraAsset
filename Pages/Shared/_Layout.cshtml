                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item" href="/Account/manageuser"> کاربران</a></li>
                                        <li><hr class="dropdown-divider" ></li>
                                        <li><a class="dropdown-item" href="/Assets/index"> اموال</a></li>
                                        <li><hr class="dropdown-divider" ></li>
                                        <li><a class="dropdown-item" href="/Properties/index"> خصوصیات</a></li>
                                        <li><hr class="dropdown-divider" ></li>

                                    }
                                    @**@
                                   @*  <li><a class="dropdown-item" href="/Report1">گزارش تغییر وضعیت </a></li>
                                    <li><a class="dropdown-item" href="/RedirectReport">گزارش ارجاع دامنه </a></li> *@
                                    <li>
                                        <form asp-area="Identity" asp-page="/Account/Logout" class="d-inline" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" method="post" id="logoutForm">

                                            <button type="submit" class="dropdown-item btn btn-danger "><i class="fa fa-sign-out"></i> خروج </button>

                                        </form>

                                    </li>

                                </ul>
