
@page
@model SatraAsset.Pages.Assets.IndexModel
@{
}
@using SatraAsset.Model

@{
    ViewData["Title"] = "مدیریت اموال";
}


<div class="container-fluid">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">مدیریت اموال</h4>
            <p class="text-muted mb-0">
                لیست و مدیریت اموال سازمان
            </p>
        </div>

        <a asp-page="./Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            ثبت مال جدید
        </a>
    </div>

    <!-- Search & Filter -->
    <div class="card mb-4">
        <div class="card-body">

            <form method="get">

                <div class="row g-3">

                    <!-- Search -->
                    <div class="col-md-5">
                        <label class="form-label">
                            جستجو
                        </label>

                        <input asp-for="Search"
                               class="form-control"
                               placeholder="نام، کد اموال یا شماره سریال..." />
                    </div>

                    <!-- Status -->
                    <div class="col-md-3">
                        <label class="form-label">
                            وضعیت
                        </label>

                        <select asp-for="Status"
                                asp-items="Html.GetEnumSelectList<AssetStatus>()"
                                class="form-select">

                            <option value="">
                                همه وضعیت‌ها
                            </option>

                        </select>
                    </div>

                    <!-- Buttons -->
                    <div class="col-md-4 d-flex align-items-end gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            <i class="bi bi-search"></i>
                            جستجو
                        </button>

                        <a asp-page="./Index"
                           class="btn btn-outline-secondary">
                            پاک کردن
                        </a>

                    </div>

                </div>

            </form>

        </div>
    </div>

    <!-- Assets Table -->
    <div class="card">

        <div class="card-header d-flex justify-content-between align-items-center">

            <span class="fw-bold">
                لیست اموال
            </span>

            <span class="badge bg-secondary">
                @Model.totalcount مورد
            </span>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>کد اموال</th>
                            <th>نام مال</th>
                            <th>دسته‌بندی</th>
                            <th>محل استقرار</th>
                            <th>شماره سریال</th>
                            <th>قیمت خرید</th>
                            <th>وضعیت</th>
                            <th class="text-center">عملیات</th>
                        </tr>
                    </thead>

                    <tbody>

                    @if (Model.Assets.Any())
                    {
                        var row = 1;

                        foreach (var asset in Model.Assets)
                        {
                            <tr>

                                <td>
                                    @(row+ ((Model.currentPage-1)*Model.pageSize))
                                </td>

                                <td>
                                    <span class="fw-semibold">
                                        @asset.AssetCode
                                    </span>
                                </td>

                                <td>
                                    @asset.Name
                                </td>

                                <td>
                                    @asset.Category.Name
                                </td>

                                <td>
                                    @asset.Location.Name
                                </td>

                                <td>
                                    @asset.SerialNumber
                                </td>

                                <td>
                                    @asset.PurchasePrice.ToString("N0")
                                </td>

                                <td>
                                    @switch (asset.Status)
                                    {
                                        case AssetStatus.Active:
                                            <span class="badge bg-success">
                                                فعال
                                            </span>
                                            break;

                                        case AssetStatus.Inactive:
                                            <span class="badge bg-secondary">
                                                غیرفعال
                                            </span>
                                            break;

                                        case AssetStatus.UnderMaintenance:
                                            <span class="badge bg-warning text-dark">
                                                در حال تعمیر
                                            </span>
                                            break;

                                        case AssetStatus.Retired:
                                            <span class="badge bg-dark">
                                                بازنشسته
                                            </span>
                                            break;

                                        case AssetStatus.Lost:
                                            <span class="badge bg-danger">
                                                مفقود شده
                                            </span>
                                            break;
                                    }
                                </td>

                                <td class="text-center">

                                    <div class="btn-group">

                                        <a asp-page="./Details"
                                           asp-route-id="@asset.Id"
                                           class="btn btn-sm btn-outline-info"
                                           title="جزئیات">
                                            <i class="bi bi-eye"></i>
                                            
                                        </a>

                                        <a asp-page="./Edit"
                                           asp-route-id="@asset.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="ویرایش">
                                            <i class="bi bi-pencil"></i>
                                            
                                        </a>

                                        <a asp-page="./Delete"
                                           asp-route-id="@asset.Id"
                                           class="btn btn-sm btn-outline-danger"
                                           title="حذف">
                                            <i class="bi bi-trash"></i>
                                            
                                        </a>

                                    </div>

                                </td>

                            </tr>

                            row++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9"
                                class="text-center py-5">

                                <div class="text-muted">

                                    <i class="bi bi-inbox fs-1"></i>

                                    <div class="mt-2">
                                        موردی برای نمایش وجود ندارد.
                                    </div>

                                </div>

                            </td>
                        </tr>
                    }

                    </tbody>

                </table>
                <br />
                @if (Model.TotalPages > 1)
{
    <nav aria-label="Product pagination" >
        <ul class="pagination  justify-content-center">

            <li class="page-item @(Model.currentPage == 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-page="./Index"
                   asp-route-pagenumber="@(Model.currentPage - 1)"
                    asp-route-status="@(Model.Status)"
                    asp-route-search="@(Model.Search)">
                    قبلی
                </a>
            </li>

            @* @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.currentPage ? "active" : "")">
                    <a class="page-link"
                       asp-page="./Index"
                       asp-route-pagenumber="@i">
                        @i
                    </a>
                </li>
            } *@

            <li class="page-item @(Model.currentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-page="./Index"
                   asp-route-pagenumber="@(Model.currentPage + 1)"
                    asp-route-status="@(Model.Status)"
                    asp-route-search="@(Model.Search)">
                
                    بعدی
                </a>
            </li>

        </ul>
    </nav>
}
            </div>

        </div>

    </div>

</div>
@section Scripts {


}