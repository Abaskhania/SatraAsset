@page
@model SatraAsset.Pages.Properties.IndexModel
@{
}


@using SatraAsset.Model

@{
    ViewData["Title"] = "مدیریت اموال";
}


<div class="container-fluid">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">مدیریت خصوصیات</h4>
            <p class="text-muted mb-0">
                لیست خصوصیات دسته بندی
            </p>
        </div>

        <a asp-page="./Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            ثبت خصوصیت جدید
        </a>
    </div>

    <!-- Search & Filter -->
    <div class="card mb-4">
        <div class="card-body">

            <form method="get">

                <div class="row g-3">

                    <!-- Search -->
                    <div class="col-md-5">
                        <label class="form-label">
                            جستجو
                        </label>

                        <input asp-for="Search"
                               class="form-control"
                               placeholder="نام..." />
                    </div>

                    <!-- Status -->
                    <div class="col-md-3">
                        <label class="form-label">
                            دسته بندی
                        </label>

                        <select asp-for="@Model.CategoryID"
                                asp-items="@Model.AssetCategories"
                                class="form-select">

                            <option value="">
                                همه دسته بندی ‌ها
                            </option>

                        </select>
                    </div>

                    <!-- Buttons -->
                    <div class="col-md-4 d-flex align-items-end gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            <i class="bi bi-search"></i>
                            جستجو
                        </button>

                        <a asp-page="./Index"
                           class="btn btn-outline-secondary">
                            پاک کردن
                        </a>

                    </div>

                </div>

            </form>

        </div>
    </div>

    <!-- Assets Table -->
    <div class="card">

        <div class="card-header d-flex justify-content-between align-items-center">

            <span class="fw-bold">
                لیست خصوصیات
            </span>

            <span class="badge bg-secondary">
                @Model.totalcount مورد
            </span>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>نام خصوصیت</th>
                            <th>نوع خصوصبت</th>
                            <th>دسته بندی</th>
                            <th>ترتیب</th>
                            <th>گزینه ها</th>

                            
                            <th class="text-center">عملیات</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.AssetProperties.Any())
                        {
                            var row = 1;

                            foreach (var property in Model.AssetProperties)
                            {
                                <tr>

                                    <td>
                                        @(row + ((Model.currentPage - 1) * Model.pageSize))
                                    </td>

                                    <td>
                                        <span class="fw-semibold">
                                            @property.Name
                                        </span>
                                    </td>
                                    <td>
                                        @switch (property.DataType)
                                        {

                             
                                            case PropertyDataType.String:
                                                <span class="badge bg-success">
                                                    رشته ای
                                                </span>
                                                break;

                                            case PropertyDataType.Number:
                                                <span class="badge bg-secondary">
                                                    عددی
                                                </span>
                                                break;

                                            case PropertyDataType.Date:
                                                <span class="badge bg-warning text-dark">
                                                    تاریخ
                                                </span>
                                                break;

                                            case PropertyDataType.Boolean:
                                                <span class="badge bg-dark">
                                                    منطقی
                                                </span>
                                                break;

                                            case PropertyDataType.Select:
                                                <span class="badge bg-danger">
                                                    گزینه ای
                                                </span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @property.Category.Name
                                    </td>

                                    <td>
                                        @property.SortOrder
                                    </td>

                                    <td>
                                        @property.OptionsJson
                                    </td>

                                                                
                                
                                    <td class="text-center">

                                        <div class="btn-group">

                                            <a asp-page="./Details"
                                               asp-route-id="@property.Id"
                                               class="btn btn-sm btn-outline-info"
                                               title="جزئیات">
                                                <i class="bi bi-eye"></i>

                                            </a>

                                            <a asp-page="./Edit"
                                               asp-route-id="@property.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="ویرایش">
                                                <i class="bi bi-pencil"></i>

                                            </a>

                                            <a asp-page="./Delete"
                                               asp-route-id="@property.Id"
                                               class="btn btn-sm btn-outline-danger"
                                               title="حذف">
                                                <i class="bi bi-trash"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>

                                row++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="bi bi-inbox fs-1"></i>

                                        <div class="mt-2">
                                            موردی برای نمایش وجود ندارد.
                                        </div>

                                    </div>

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>
                <br />
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Product pagination">
                        <ul class="pagination  justify-content-center">

                            <li class="page-item @(Model.currentPage == 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-page="./Index"
                                   asp-route-pagenumber="@(Model.currentPage - 1)"
                                   asp-route-CategoryID="@(Model.CategoryID)"
                                   asp-route-search="@(Model.Search)">
                                    &lt;

                                </a>
                            </li>

                            @{
                                int current = Model.currentPage;
                                int total = Model.TotalPages;

                                var pages = new List<int>();

                                // صفحات ابتدایی
                                pages.Add(1);

                                if (total >= 2)
                                    pages.Add(2);

                                // اطراف صفحه فعلی
                                for (int i = current - 2; i <= current + 2; i++)
                                {
                                    if (i > 2 && i < total - 1)
                                        pages.Add(i);
                                }

                                // صفحات انتهایی
                                if (total >= 2)
                                    pages.Add(total - 1);

                                if (total >= 1)
                                    pages.Add(total);

                                pages = pages
                                    .Where(x => x >= 1 && x <= total)
                                    .Distinct()
                                    .OrderBy(x => x)
                                    .ToList();
                            }

                            @{
                                int previous = 0;
                            }
                            @foreach (var pageNumber in pages)
                            {
                                if (previous != 0 && pageNumber > previous + 1)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }

                                <li class="page-item @(pageNumber == current ? "active" : "")">
                                    <a class="page-link"
                                       asp-route-pagenumber="@pageNumber"
                                       asp-route-CategoryID="@(Model.CategoryID)"
                                       asp-route-search="@(Model.Search)">
                                        @pageNumber
                                    </a>
                                </li>

                                previous = pageNumber;
                            }

                            <li class="page-item @(Model.currentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-page="./Index"
                                   asp-route-pagenumber="@(Model.currentPage + 1)"
                                   asp-route-CategoryID="@(Model.CategoryID)"
                                   asp-route-search="@(Model.Search)">
                                    &gt;
                                </a>
                            </li>

                        </ul>
                    </nav>
                }
            </div>

        </div>

    </div>

</div>
@section Scripts {


}